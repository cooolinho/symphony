# Symphony configuration. The easiest way to create .env is the installer: ./install.sh (docs/install.md).
# By hand: cp .env.example .env && chmod 600 .env, then fill in the values below.
# This file holds only the values most setups need; every other variable, with its default, is in
# docs/environment.md. Variables set in the shell win over .env; restart Symphony after a change.

# GitHub project board: its number, or the full URL
# (https://github.com/users/<owner>/projects/<number> or https://github.com/orgs/<org>/projects/<number>)
GITHUB_PROJECT_NUMBER=
# Repository whose issues Symphony works on: owner/name; comma-separate several repositories on the same board.
GITHUB_REPOSITORY=owner/name
# Classic token with the scopes "repo" and "project" (or: gh auth refresh -s project && gh auth token).
# It stays in the Symphony process: agents and hooks never see it.
GITHUB_TOKEN=

# Default model of the developer: fable, opus, sonnet, haiku or a full model id (empty = Claude Code default).
# A "Model: <model>" / "Effort: <level>" label on an issue overrides it (create the labels with: npm run repo-init).
CLAUDE_MODEL=opus
# CLAUDE_EFFORT=

# Dashboard and JSON API on http://127.0.0.1:<port>/ (docker compose defaults to 4000).
# SYMPHONY_PORT=4000
# Integration branch for pull requests (empty = the default branch); SYMPHONY_AUTO_MERGE=true merges approved,
# green pull requests into it (see docs/usage.md#auto-merge-into-develop).
# SYMPHONY_BASE_BRANCH=develop
# SYMPHONY_AUTO_MERGE=false
# Agents running at the same time (default 3 from WORKFLOW.md; about 1 CPU and 2 GB RAM each).
# SYMPHONY_MAX_CONCURRENT_AGENTS=3

# ── Docker (docker-compose.local.yml and docker-compose.yml, see docs/docker.md) ──
# Claude credentials from: claude setup-token (or set ANTHROPIC_API_KEY). The SSH deploy key goes to ./secrets/ssh_key.
# CLAUDE_CODE_OAUTH_TOKEN=
# GIT_USER_NAME=Symphony
# GIT_USER_EMAIL=symphony@example.com

# ── Docker behind Traefik (docker-compose.yml only) ──
# SYMPHONY_DOMAIN=symphony.example.com
# Dashboard login (htpasswd -nB admin): keep the single quotes and every $ single (no $$).
# SYMPHONY_BASIC_AUTH='admin:$2y$05$...'
# TRAEFIK_NETWORK=traefik
