# Copy to .env (next to WORKFLOW.md) and fill in. Variables set in the shell take precedence.
# For several setups, keep one file per board/repository and start with --env-file <file>.

# GitHub project board: its number, or the full URL
# (https://github.com/users/<owner>/projects/<number> or https://github.com/orgs/<org>/projects/<number>)
GITHUB_PROJECT_NUMBER=10

# Repository whose issues Symphony works on: owner/name. Comma-separate several repositories
# that share the board; issues from other repositories on the board are ignored.
GITHUB_REPOSITORY=cooolinho/trainingsstunden-portal

# Default model for Claude Code: an alias (opus, sonnet, haiku) or a full model id. Empty = Claude Code default.
# A "Model: <model>" label on an issue overrides it for that issue (create the labels with: npm run repo-init).
CLAUDE_MODEL=opus

# Default effort for Claude Code: low, medium, high, xhigh or max. Empty = Claude Code default.
# An "Effort: <level>" label on an issue overrides it for that issue (create the labels with: npm run repo-init).
CLAUDE_EFFORT=

# GitHub token with the "repo" and "project" scopes (classic token), or reuse the gh login:
#   gh auth refresh -s project && gh auth token
# Symphony keeps it to itself: it is removed from the environment of agents and hooks.
GITHUB_TOKEN=

# Optional
# GITHUB_PROJECT_OWNER=my-org   # board owner, if it is not the owner of the first repository
# SYMPHONY_PORT=4000            # dashboard and JSON API on http://127.0.0.1:4000/
# SYMPHONY_HOST=127.0.0.1       # dashboard bind address; 0.0.0.0 only behind an authenticating reverse proxy
# SYMPHONY_ALLOW_REMOTE_CONTROL=false  # true: Retry/Resume now on a non-loopback bind (requires a matching Origin)
# ANTHROPIC_API_KEY=            # otherwise Claude Code uses its existing login
# SYMPHONY_LOG_DIR=logs         # repository logs and transcripts (default ~/.local/state/symphony)

# Orchestrator limits (referenced in WORKFLOW.md as ${VAR:-default}; restart after editing .env)
SYMPHONY_MAX_CONCURRENT_AGENTS=1
SYMPHONY_MAX_TURNS=5
# Continuation sessions while the card stays active; after that Symphony pauses the issue (empty = unlimited).
# Role switches (developer <-> reviewer) count as continuations, so keep a limit.
SYMPHONY_MAX_CONTINUATIONS=6
# Retries per issue after the first session-limit failure; after that the worker waits for the reset
# (retry at = reset + 1 minute, in memory only; 0 = wait right away). An unknown reset keeps the normal backoff.
SYMPHONY_MAX_SESSION_LIMIT_RETRIES=3
SYMPHONY_POLL_INTERVAL_MS=30000
# Delete the workspace (and whatever before_remove cleans up) once an issue reaches "Done"
SYMPHONY_CLEANUP_TERMINAL=true

# Integration branch agents branch from and open pull requests against (e.g. develop); empty = the default branch.
SYMPHONY_BASE_BRANCH=
# true: once the reviewer moves an issue to "In review" (checks passed), Symphony merges its pull request into
# SYMPHONY_BASE_BRANCH, closes the issue and moves it to "Done". Needs SYMPHONY_BASE_BRANCH; never merges into the
# default branch; label "manual-merge" opts out. Used by the /auto-code autopilot (see docs/usage.md).
SYMPHONY_AUTO_MERGE=false

# Laravel Boost for Laravel workspaces (see README, "Laravel Boost"); defaults: auto, php, composer
# SYMPHONY_LARAVEL_BOOST=off
# SYMPHONY_PHP=/usr/bin/php8.4
# SYMPHONY_COMPOSER=/usr/local/bin/composer

# Docker (docker compose; see docs/docker.md)
# Not needed without Docker, hence commented out. The SSH deploy key goes to ./secrets/ssh_key (git-ignored);
# set SYMPHONY_SSH_KEY only if it is mounted at another path than /run/secrets/ssh_key.
# CLAUDE_CODE_OAUTH_TOKEN=          # from: claude setup-token (or set ANTHROPIC_API_KEY)
# GIT_USER_NAME=Symphony            # git identity for the agents' commits
# GIT_USER_EMAIL=symphony@example.com
# SYMPHONY_DOMAIN=symphony.example.com   # required: dashboard host name in Traefik
# Dashboard login (htpasswd -nB admin). Keep the single quotes and every $ single (no $$): quoted,
# docker compose takes the value literally and Node's util.parseEnv reads it unchanged.
# SYMPHONY_BASIC_AUTH='admin:$2y$05$...'
# SYMPHONY_TRAEFIK_MIDDLEWARES=authelia@docker   # instead of the BasicAuth, e.g. a@file,b@docker
# TRAEFIK_NETWORK=traefik           # external network of the Traefik project
# TRAEFIK_ENTRYPOINT=websecure      # HTTPS entrypoint
# TRAEFIK_TLS=true                  # false: plain HTTP for a LAN Traefik without certificates (with TRAEFIK_ENTRYPOINT=web)
# TRAEFIK_CERTRESOLVER=letsencrypt
# UID=1000                          # build args: owner of the volumes and of ./secrets/ssh_key
# GID=1000
# PHP_VERSION=8.4
# TZ=Europe/Berlin
# SYMPHONY_SSH_KEY=/run/secrets/ssh_key

# History transfer to the server (scripts/push-history.sh, see docs/docker.md). Read on the machine running the script.
# SYMPHONY_CONTAINER=symphony             # container name on the server (default: symphony)
# SYMPHONY_REMOTE=cooolinho@docker.lan    # ssh target
