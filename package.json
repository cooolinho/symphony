{
  "name": "symphony",
  "version": "1.0.1",
  "description": "Symphony orchestrator: polls a GitHub Projects board and runs one Claude Code session per issue in an isolated workspace.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "symphony": "./src/cli.ts"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "dry-run": "node src/cli.ts --dry-run",
    "repo-init": "node repo-init.ts",
    "e2e": "node scripts/e2e/run.ts",
    "test:laravel": "node scripts/laravel-smoke/run.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.288",
    "liquidjs": "^10.30.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
